{
    "version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"label": "Compile",
			"group": "build",
			"linux": {
				"command": ". ${workspaceRoot}/3rdp/oss-cad-suite-build/oss-cad-suite/environment;${workspaceRoot}/../traktor/bin/linux/releasestatic/Traktor.Run.App ${workspaceRoot}/build.run --compile;",
				"problemMatcher": [
					"$gcc"
				]
			},
		},
		{
			"type": "shell",
			"label": "Compile+Synthesize",
			"group": "build",
			"linux": {
				"command": ". ${workspaceRoot}/3rdp/oss-cad-suite-build/oss-cad-suite/environment;${workspaceRoot}/../traktor/bin/linux/releasestatic/Traktor.Run.App ${workspaceRoot}/build.run --compile --synth;",
				"problemMatcher": [
					"$gcc"
				]
			},
		},
		{
			"type": "shell",
			"label": "Compile+Synthesize+Program",
			"group": "build",
			"linux": {
				"command": ". ${workspaceRoot}/3rdp/oss-cad-suite-build/oss-cad-suite/environment;${workspaceRoot}/../traktor/bin/linux/releasestatic/Traktor.Run.App ${workspaceRoot}/build.run --compile --synth --prog;",
				"problemMatcher": [
					"$gcc"
				]
			},
		},
		{
			"type": "shell",
			"label": "Compile+Synthesize+Flash",
			"group": "build",
			"linux": {
				"command": ". ${workspaceRoot}/3rdp/oss-cad-suite-build/oss-cad-suite/environment;${workspaceRoot}/../traktor/bin/linux/releasestatic/Traktor.Run.App ${workspaceRoot}/build.run --compile --synth --prog --flash;",
				"problemMatcher": [
					"$gcc"
				]
			},
		},
	]
}