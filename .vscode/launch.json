{
	"version": "0.2.0",
	"configurations": [

		{
			"name": "... Emulator HL",
			"request": "launch",
			"type": "cppdbg",
			"program": "${workspaceRoot}/build/linux/ReleaseStatic/RetroDACK.Emulator",
			"args": [
				"--hl",
				"--gdb"
			],
			"stopAtEntry": false,
			"cwd": "${workspaceRoot}",
			"environment": [],
			"externalConsole": false,
			"MIMode": "gdb",
			"setupCommands": [
				{
					"description": "Enable pretty-printing for gdb",
					"text": "-enable-pretty-printing",
					"ignoreFailures": true
				}
			],
		},

		{
			"name": "... Emulator GL",
			"request": "launch",
			"type": "cppdbg",
			"program": "${workspaceRoot}/build/linux/ReleaseStatic/RetroDACK.Emulator",
			"args": [
				"--gl",
				//"--fst",
				"--gdb"
			],
			"stopAtEntry": false,
			"cwd": "${workspaceRoot}",
			"environment": [],
			"externalConsole": false,
			"MIMode": "gdb",
			"setupCommands": [
				{
					"description": "Enable pretty-printing for gdb",
					"text": "-enable-pretty-printing",
					"ignoreFailures": true
				}
			],
		},

		{
			"type": "gdb",
			"request": "attach",
			"name": "... RV Firmware (Debug)",
			"executable": "${workspaceRoot}/build/rv/DebugStatic/Firmware",
			"target": ":12345",
			"remote": true,
			"cwd": "${workspaceRoot}",
			"gdbpath": "/opt/riscv/bin/riscv32-unknown-elf-gdb",
			"autorun": [
				"load"
			]
		},
		{
			"type": "gdb",
			"request": "attach",
			"name": "... RV Firmware (Release)",
