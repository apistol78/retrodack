{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Emulator",
			"request": "launch",
			"type": "cppdbg",
			"program": "${workspaceRoot}/build/linux/ReleaseStatic/RetroDACK.Emulator",
			"args": [
				"--elf=${workspaceRoot}/build/rv/ReleaseStatic/Firmware"
			],
			"stopAtEntry": false,
			"cwd": "${workspaceRoot}",
			"environment": [],
			"externalConsole": false,
			"MIMode": "gdb",
			"setupCommands": [
				{
					"description": "Enable pretty-printing for gdb",
					"text": "-enable-pretty-printing",
					"ignoreFailures": true
				}
			],
		},
	]
}