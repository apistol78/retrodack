import(traktor)

run:loadScript("CSV.run")

function main()

	local FILES =
	{
		"pin-clock.csv",
		"pin-lcd.csv",
		"pin-uart.csv",
		"pin-i2c.csv",
		"pin-i2s.csv",
		"pin-sd.csv",
		"pin-usb-hci.csv",
		"pin-sram.csv",
		"pin-sdram.csv",
		"pin-spi-flash.csv",
	}

	local po < const > = CSV.load("docs/pinout.csv")
	local used = {}

	stdout:printLn("// Autogenerated, DO NOT EDIT!")
	stdout:printLn("SYSCONFIG MASTER_SPI_PORT=DISABLE;")
	stdout:printLn("")

	for _, f in ipairs(FILES) do
		local csv = CSV.load("docs/" .. f)
		for _, r in pairs(csv.rows) do
			local fpga = csv:getValue(r, "FPGA")
			local name = csv:getValue(r, "Signal")
			local designator = csv:getValue(r, "Designator")
			local freq = csv:getValue(r, "Frequency")
			local iotype = csv:getValue(r, "IOType")
			local pullmode = csv:getValue(r, "PullMode")
			local slewRate = csv:getValue(r, "SlewRate")
			local drive = csv:getValue(r, "Drive")

			-- Do some sanity cross checks.
			local rr = po:find("Designator", function(v) return v == designator end)
			if rr == nil then
				stderr:printLn("No such designator in pinout " .. designator)
				return 1
			end
			if po:getValue(rr, "SODIMM") ~= "" and po:getValue(rr, "FPGA") ~= fpga then
				stderr:printLn("Invalid SODIMM signal " .. fpga .. " != " .. po:getValue(rr, "FPGA"))
				return 1
			end

			-- Ensure pin hasn't already been used.
			if used[designator] ~= nil then
				stderr:printLn("Designator " .. designator .. " already used.")
				return 1
			end
			used[designator] = true

			stdout:printLn("// Designator " .. designator)
			stdout:printLn("LOCATE COMP \"" .. name .. "\" SITE \"" .. fpga .. "\";")

			if iotype ~= nil and iotype ~= "" then
				stdout:printLn("IOBUF PORT \"" .. name .. "\" IO_TYPE=" .. iotype .. ";")
			else
				stdout:printLn("IOBUF PORT \"" .. name .. "\" IO_TYPE=LVCMOS25;")
			end

			if pullmode ~= nil and pullmode ~= "" then
				stdout:printLn("IOBUF PORT \"" .. name .. "\" PULLMODE=" .. pullmode .. ";")
			end

			if slewRate ~= nil and slewRate ~= "" then
				stdout:printLn("IOBUF PORT \"" .. name .. "\" SLEWRATE=" .. slewRate .. ";")
			end

			if drive ~= nil and drive ~= "" then
				stdout:printLn("IOBUF PORT \"" .. name .. "\" DRIVE=" .. drive .. ";")
			end

			if freq ~= nil and freq ~= "" then
				stdout:printLn("FREQUENCY PORT \"" .. name .. "\" " .. freq .. " MHZ;")
			end

			stdout:printLn("")
		end
	end
end
